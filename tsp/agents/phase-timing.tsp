/**
 * @module Shep.Agents.PhaseTiming
 *
 * Timing record for a single agent graph node execution.
 * Tracks start, completion, and duration for each phase
 * of the agent lifecycle. Stored in the phase_timings table.
 */
import "../common/base.tsp";

@doc("Execution record for a single agent graph node. Tracks timing, prompt, token usage, and outcome.")
model PhaseTiming extends BaseEntity {
  @doc("Agent run this timing belongs to")
  agentRunId: string;

  @doc("Graph node name: analyze, requirements, research, plan, implement")
  phase: string;

  @doc("When the phase started executing")
  startedAt: utcDateTime;

  @doc("When the phase finished executing (null if still running)")
  completedAt?: utcDateTime;

  @doc("Duration in milliseconds (computed on completion)")
  durationMs?: int64;

  @doc("When the phase started waiting for user approval (null if no approval needed)")
  waitingApprovalAt?: utcDateTime;

  @doc("Duration in milliseconds the phase waited for user approval (null if no approval needed)")
  approvalWaitMs?: int64;

  @doc("The composed prompt sent to the agent for this phase")
  prompt?: string;

  @doc("Model identifier used for this phase execution")
  modelId?: string;

  @doc("Agent executor type: claude-code, cursor, gemini-cli")
  agentType?: string;

  @doc("Number of input tokens consumed (prompt + context)")
  inputTokens?: int64;

  @doc("Number of output tokens generated by the agent")
  outputTokens?: int64;

  @doc("Tokens used to populate the prompt cache (cache misses)")
  cacheCreationInputTokens?: int64;

  @doc("Tokens served from the prompt cache (cache hits)")
  cacheReadInputTokens?: int64;

  @doc("Estimated cost in USD for this phase execution")
  costUsd?: float64;

  @doc("Number of agentic turns (tool-call round-trips) in this phase")
  numTurns?: int32;

  @doc("Time spent waiting for the API (excludes tool execution)")
  durationApiMs?: int64;

  @doc("Execution outcome: success, error, timeout, interrupted")
  exitCode?: string;

  @doc("Error details when exitCode is not success")
  errorMessage?: string;

  @doc("Estimated token count before optimization (chars / 4 heuristic)")
  originalTokenEstimate?: int64;

  @doc("Estimated token count after optimization (chars / 4 heuristic)")
  optimizedTokenEstimate?: int64;

  @doc("Percentage of tokens saved by optimization ((original - optimized) / original * 100)")
  savingsPercent?: float64;

  @doc("JSON array of optimization capability names that were applied")
  capabilitiesApplied?: string;

  @doc("Number of lines removed by the command output filter")
  outputFilterLinesRemoved?: int32;

  @doc("Number of spec files replaced with compact summaries by delta-context")
  deltaContextFilesSkipped?: int32;

  @doc("Compression ratio achieved by semantic text compression (compressed / original)")
  compressionRatio?: float64;

  @doc("Number of alias substitutions created by the alias compression engine")
  aliasesCreated?: int32;
}
