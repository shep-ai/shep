{
  "components": {
    "schemas": {
      "AgentKind": {
        "description": "The coding agents Shep can run. Which one runs is a setting, never hardcoded.",
        "enum": [
          "ClaudeCode",
          "Codex",
          "Gemini"
        ],
        "type": "string"
      },
      "AgentOutput": {
        "description": "Pushed after `agent.watch`: bytes the agent printed.",
        "properties": {
          "data": {
            "description": "Base64 bytes.",
            "type": "string"
          },
          "id": {
            "$ref": "#/components/schemas/TaskId"
          }
        },
        "required": [
          "id",
          "data"
        ],
        "type": "object"
      },
      "Board": {
        "description": "Every task, grouped by state in the order a person reviews them.",
        "properties": {
          "merged": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "type": "array"
          },
          "needs_you": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "type": "array"
          },
          "queued": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "type": "array"
          },
          "ready": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "type": "array"
          },
          "working": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "type": "array"
          }
        },
        "required": [
          "needs_you",
          "ready",
          "working",
          "queued",
          "merged"
        ],
        "type": "object"
      },
      "Brief": {
        "description": "What finished overnight and what needs you, for the first look in the morning.",
        "properties": {
          "at": {
            "$ref": "#/components/schemas/UnixTime"
          },
          "done": {
            "description": "Ready for review.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "items": {
            "description": "Needs you first, then ready, then still working.",
            "items": {
              "$ref": "#/components/schemas/BriefItem"
            },
            "type": "array"
          },
          "mergeable": {
            "description": "Ready, with CI green and a pull request: the \"merge the N green\" button.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "overnight": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Overnight"
              },
              {
                "type": "null"
              }
            ]
          },
          "total": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "while_you_slept": {
            "description": "At most one line about something Shep noticed.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "at",
          "items",
          "done",
          "total",
          "mergeable"
        ],
        "type": "object"
      },
      "BriefItem": {
        "properties": {
          "summary": {
            "description": "\"CI green · +41 -12 · screenshot\", \"needs you: which bucket?\".",
            "type": "string"
          },
          "task": {
            "$ref": "#/components/schemas/Task"
          }
        },
        "required": [
          "task",
          "summary"
        ],
        "type": "object"
      },
      "CheckState": {
        "enum": [
          "Pending",
          "Passed",
          "Failed",
          "Skipped"
        ],
        "type": "string"
      },
      "CiCheck": {
        "description": "One CI check on the task's pull request.",
        "properties": {
          "link": {
            "description": "Where its log lives, when CI says.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/CheckState"
          }
        },
        "required": [
          "name",
          "state"
        ],
        "type": "object"
      },
      "ClockTime": {
        "description": "A time of day, like the shift start.",
        "properties": {
          "hour": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "minute": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "hour",
          "minute"
        ],
        "type": "object"
      },
      "DiffStat": {
        "description": "Lines and files a change touches.",
        "properties": {
          "added": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "files": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "removed": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "files",
          "added",
          "removed"
        ],
        "type": "object"
      },
      "EventKind": {
        "description": "What happened to a task, kept for the morning brief and the pull request's timeline.",
        "enum": [
          "WorktreeReady",
          "AgentStarted",
          "AgentFinished",
          "Asked",
          "Parked",
          "Interrupted",
          "StepFailed",
          "PrOpened",
          "Pushed",
          "CiFailed",
          "CiGreen",
          "NoCi",
          "Reviewed",
          "Ready",
          "Merged"
        ],
        "type": "string"
      },
      "Overnight": {
        "description": "When the night's work ran.",
        "properties": {
          "from": {
            "$ref": "#/components/schemas/UnixTime"
          },
          "parked_secs": {
            "description": "Time spent parked at usage limits.",
            "format": "int64",
            "type": "integer"
          },
          "to": {
            "$ref": "#/components/schemas/UnixTime"
          }
        },
        "required": [
          "from",
          "to",
          "parked_secs"
        ],
        "type": "object"
      },
      "PullRequest": {
        "description": "The draft pull request Shep opened for a task.",
        "properties": {
          "number": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "number",
          "url"
        ],
        "type": "object"
      },
      "ReviewAction": {
        "description": "The decisions a person makes on a task.",
        "oneOf": [
          {
            "enum": [
              "Merge"
            ],
            "type": "string"
          },
          {
            "additionalProperties": false,
            "properties": {
              "SendBack": {
                "properties": {
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "note"
                ],
                "type": "object"
              }
            },
            "required": [
              "SendBack"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "Answer": {
                "properties": {
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "type": "object"
              }
            },
            "required": [
              "Answer"
            ],
            "type": "object"
          }
        ]
      },
      "Settings": {
        "description": "What `shep config` sets.",
        "properties": {
          "agent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentKind"
              },
              {
                "type": "null"
              }
            ],
            "description": "`None` until onboarding picks one (or Shep detects one)."
          },
          "parallelism": {
            "description": "How many tasks run at once.",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "repo": {
            "default": null,
            "description": "The local checkout Shep works in. Every task gets its own worktree from its `origin`;\nthe checkout itself is never touched. `None` until the first `shep add` inside a\nrepository or `shep config --repo`.",
            "type": [
              "string",
              "null"
            ]
          },
          "shift_start": {
            "$ref": "#/components/schemas/ClockTime"
          }
        },
        "required": [
          "shift_start",
          "parallelism"
        ],
        "type": "object"
      },
      "SettingsChange": {
        "description": "A partial settings update; `None` keeps the current value.",
        "properties": {
          "agent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentKind"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "parallelism": {
            "default": null,
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "repo": {
            "default": null,
            "description": "The local checkout Shep works in.",
            "type": [
              "string",
              "null"
            ]
          },
          "shift_start": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClockTime"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "type": "object"
      },
      "StartOutcome": {
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "Tasks that moved to Working now (empty when the parallel limit is already reached).",
            "properties": {
              "Started": {
                "items": {
                  "$ref": "#/components/schemas/Task"
                },
                "type": "array"
              }
            },
            "required": [
              "Started"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "The shift will start at this time with this many tasks waiting.",
            "properties": {
              "Scheduled": {
                "properties": {
                  "at": {
                    "$ref": "#/components/schemas/ClockTime"
                  },
                  "queued": {
                    "format": "uint",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "at",
                  "queued"
                ],
                "type": "object"
              }
            },
            "required": [
              "Scheduled"
            ],
            "type": "object"
          }
        ]
      },
      "StartWhen": {
        "description": "When `start` should begin queued work.",
        "oneOf": [
          {
            "enum": [
              "Now"
            ],
            "type": "string"
          },
          {
            "additionalProperties": false,
            "properties": {
              "At": {
                "$ref": "#/components/schemas/ClockTime"
              }
            },
            "required": [
              "At"
            ],
            "type": "object"
          }
        ]
      },
      "StepView": {
        "description": "Where a task is, in words every surface uses the same way.",
        "oneOf": [
          {
            "enum": [
              "Queued",
              "Preparing",
              "Coding",
              "Publishing",
              "WatchingCi",
              "FixingCi",
              "Reviewing",
              "NeedsYou",
              "Ready",
              "Merged"
            ],
            "type": "string"
          },
          {
            "const": "Parked",
            "description": "Waiting out a usage limit, or a retry after a failure.",
            "type": "string"
          }
        ]
      },
      "Task": {
        "description": "The one thing in Shep: work handed over by a person.",
        "properties": {
          "created_at": {
            "$ref": "#/components/schemas/UnixTime"
          },
          "id": {
            "$ref": "#/components/schemas/TaskId"
          },
          "note": {
            "description": "The latest instruction from the person: an answer or a send-back note.",
            "type": [
              "string",
              "null"
            ]
          },
          "pr": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PullRequest"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The draft pull request, once Shep has opened one."
          },
          "question": {
            "description": "The question the agent is waiting on while the task needs you.",
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "$ref": "#/components/schemas/TaskSourceRef"
          },
          "state": {
            "$ref": "#/components/schemas/TaskState"
          },
          "title": {
            "type": "string"
          },
          "updated_at": {
            "$ref": "#/components/schemas/UnixTime"
          }
        },
        "required": [
          "id",
          "title",
          "source",
          "state",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "TaskDetail": {
        "description": "One task, as the split view and the Mac app show it.",
        "properties": {
          "activity": {
            "description": "One line on what is happening now.",
            "type": "string"
          },
          "agent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentKind"
              },
              {
                "type": "null"
              }
            ]
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/CiCheck"
            },
            "type": "array"
          },
          "diff": {
            "description": "The change as a patch (shortened for display).",
            "type": [
              "string",
              "null"
            ]
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/TaskEvent"
            },
            "type": "array"
          },
          "live": {
            "description": "Whether an agent session is running for it right now.",
            "type": "boolean"
          },
          "proof": {
            "description": "Proof files on this machine: test output and screenshots.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "review": {
            "description": "The second opinion.",
            "type": [
              "string",
              "null"
            ]
          },
          "screen": {
            "description": "The agent's screen, while it has one.",
            "type": [
              "string",
              "null"
            ]
          },
          "stat": {
            "$ref": "#/components/schemas/DiffStat"
          },
          "step": {
            "$ref": "#/components/schemas/StepView"
          },
          "task": {
            "$ref": "#/components/schemas/Task"
          }
        },
        "required": [
          "task",
          "step",
          "activity",
          "live",
          "checks",
          "stat",
          "proof",
          "events"
        ],
        "type": "object"
      },
      "TaskEvent": {
        "properties": {
          "at": {
            "$ref": "#/components/schemas/UnixTime"
          },
          "detail": {
            "description": "A sentence for a person, like \"lint failed\" or \"parked until 06:10\".",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/EventKind"
          },
          "task_id": {
            "$ref": "#/components/schemas/TaskId"
          }
        },
        "required": [
          "task_id",
          "at",
          "kind",
          "detail"
        ],
        "type": "object"
      },
      "TaskId": {
        "format": "int64",
        "type": "integer"
      },
      "TaskSourceRef": {
        "description": "A reference to the task in its source, or the sentence the user typed.",
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "`repo` is `owner/name`; `None` means the repository Shep is pointed at.",
            "properties": {
              "GitHubIssue": {
                "properties": {
                  "number": {
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "repo": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "number"
                ],
                "type": "object"
              }
            },
            "required": [
              "GitHubIssue"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "Linear": {
                "properties": {
                  "key": {
                    "type": "string"
                  }
                },
                "required": [
                  "key"
                ],
                "type": "object"
              }
            },
            "required": [
              "Linear"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "Jira": {
                "properties": {
                  "key": {
                    "type": "string"
                  }
                },
                "required": [
                  "key"
                ],
                "type": "object"
              }
            },
            "required": [
              "Jira"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "Notion": {
                "properties": {
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "url"
                ],
                "type": "object"
              }
            },
            "required": [
              "Notion"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "Monday": {
                "properties": {
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "url"
                ],
                "type": "object"
              }
            },
            "required": [
              "Monday"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "Slack": {
                "properties": {
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "url"
                ],
                "type": "object"
              }
            },
            "required": [
              "Slack"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "Sentence": {
                "properties": {
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "type": "object"
              }
            },
            "required": [
              "Sentence"
            ],
            "type": "object"
          }
        ]
      },
      "TaskState": {
        "description": "The five states every task moves through, on every surface.",
        "enum": [
          "Queued",
          "Working",
          "NeedsYou",
          "Ready",
          "Merged"
        ],
        "type": "string"
      },
      "UnixTime": {
        "description": "Seconds since the Unix epoch.",
        "format": "int64",
        "type": "integer"
      },
      "WatchReply": {
        "properties": {
          "screen": {
            "description": "Base64 bytes that redraw the agent's screen.",
            "type": "string"
          }
        },
        "required": [
          "screen"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Shep daemon",
    "version": "1.0.0"
  },
  "methods": [
    {
      "name": "add",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "from_dir",
          "required": false,
          "schema": {
            "default": null,
            "description": "Where the person was when they added it; the first time, Shep works in that repository.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        {
          "name": "input",
          "required": true,
          "schema": {
            "description": "`#412`, `owner/repo#412`, a link to a ticket or message, or a sentence.",
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/Task"
        }
      },
      "summary": "Queue a task from an issue reference, a link, or a sentence."
    },
    {
      "name": "start",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "when",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/StartWhen"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/StartOutcome"
        }
      },
      "summary": "Start queued tasks now, or set when tonight's shift starts."
    },
    {
      "name": "board",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "summary": "Every task, grouped by state in review order."
    },
    {
      "name": "review",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "action",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ReviewAction"
          }
        },
        {
          "name": "id",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/TaskId"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/Task"
        }
      },
      "summary": "A person's decision: merge, send back with a note, or answer."
    },
    {
      "name": "settings.get",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/Settings"
        }
      },
      "summary": "The current settings."
    },
    {
      "name": "settings.update",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "change",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/SettingsChange"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/Settings"
        }
      },
      "summary": "Change some settings; fields left out keep their value."
    },
    {
      "name": "board.subscribe",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "summary": "The board now, then a board.changed notification on every change."
    },
    {
      "name": "task.detail",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "id",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/TaskId"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/TaskDetail"
        }
      },
      "summary": "One task in full: its run, what it is doing, CI, diff, proof, review."
    },
    {
      "name": "brief",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/Brief"
        }
      },
      "summary": "What finished, what needs you, and how the night went."
    },
    {
      "name": "brief.morning",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/Brief"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "summary": "The brief once per morning; null when nothing is new."
    },
    {
      "name": "day.first_run",
      "paramStructure": "by-name",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "type": "boolean"
        }
      },
      "summary": "True the first time it is asked on a new local day."
    },
    {
      "name": "add.label",
      "paramStructure": "by-name",
      "params": [
