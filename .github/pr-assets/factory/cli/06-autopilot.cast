[21.160634, "o", "\r\n  \u001b[1m\u001b[36mFeatures (1)\u001b[39m\u001b[22m\r\n\r\n  \u001b[90mNAME                                        \u001b[39m  \u001b[90mSTATUS                \u001b[39m  \u001b[90mR P M ↑   \u001b[39m  \u001b[90mELAPSED  \u001b[39m  \u001b[90mDONE\u001b[39m\r\n\r\n  \u001b[1m\u001b[36mpay-api\u001b[39m\u001b[22m  \u001b[90m/tmp/claude-0/demo/work/pay-api\u001b[39m\r\n  └─ \u001b[90meeb78213\u001b[39m  Fix PAY-1: Unhandled edge case...  \u001b[36m>\u001b[39m \u001b[36mReview Merge\u001b[39m          \u001b[32m■\u001b[39m \u001b[32m■\u001b[39m \u001b[90m□\u001b[39m \u001b[90m□\u001b[39m     \u001b[90m0s\u001b[39m         \r\n"]
