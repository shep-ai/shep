  {
   "id": "onboard1",
   "chapter": "Getting started",
   "type": "shots",
   "lines": [
    {
     "text": "Shep starts by asking where your tasks come from today.",
     "shot": {
      "img": "OnboardingSources",
      "from": [
       40,
       150,
       680,
       560
      ],
      "to": [
       50,
       165,
       640,
       530
      ]
     },
     "start": 170.163,
     "dur": 3.158
    },
    {
     "text": "Linear, Jira, Notion, Monday, Slack, GitHub, or nowhere in particular.",
     "start": 173.701,
     "dur": 5.979
    },
    {
     "text": "Connect them with a click. Your tokens stay in your Mac's keychain.",
     "shot": {
      "img": "OnboardingSources",
      "from": [
       670,
       150,
       680,
       560
      ],
      "to": [
       680,
       165,
       640,
       530
      ]
     },
     "start": 180.06,
     "dur": 3.471
    },
    {
     "text": "Then it shows the moves you'll use to hand work over. The same ones you make today.",
     "shot": {
      "img": "OnboardingSources",
      "from": [
       1280,
       150,
       680,
       560
      ],
      "to": [
       1290,
       165,
       640,
       530
      ]
     },
     "start": 183.911,
     "dur": 4.725
    }
   ],
   "start": 169.463,
   "end": 190.117
  },
  {
