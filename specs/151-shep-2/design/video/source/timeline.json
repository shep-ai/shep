       820
      ]
     },
     "start": 154.853,
     "dur": 2.659
    },
    {
     "text": "That's your morning: five minutes, not five hours.",
     "start": 157.892,
     "dur": 3.332
    }
   ],
   "start": 154.153,
   "end": 162.704
  },
