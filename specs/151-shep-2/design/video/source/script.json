  {
   "id": "decide",
   "chapter": "Morning \u00b7 review",
   "type": "decide",
   "lines": [
    {
     "text": "You decide with one key. M to merge. S to send it back, with a note."
    },
    {
     "text": "Shep never merges on its own. You always press the button."
    }
   ]
  },
