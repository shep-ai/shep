{
  "domain": "code.expertreg.com",
  "proxy": "nginx",
  "tls": {
    "cert": "/etc/letsencrypt/live/code.expertreg.com/fullchain.pem",
    "key": "/etc/letsencrypt/live/code.expertreg.com/privkey.pem"
  },
  "htpasswdDir": "/etc/nginx/shep",
  "appDir": "/srv/shep/app",
  "tenantsRoot": "/srv/shep/tenants",
  "appEntry": "dist/src/presentation/cli/index.js",
  "bindHost": "127.0.0.1",
  "tenants": [
    {
      "id": "companyA",
      "subdomain": "companya",
      "port": 4051,
      "authUser": "companya",
      "authHash": "REPLACE_WITH_htpasswd_-nbB_hash"
    },
    {
      "id": "companyB",
      "subdomain": "companyb",
      "port": 4052,
      "authUser": "companyb",
      "authHash": "REPLACE_WITH_htpasswd_-nbB_hash"
    },
    {
      "id": "companyC",
      "subdomain": "companyc",
      "port": 4053,
      "authUser": "companyc",
      "authHash": "REPLACE_WITH_htpasswd_-nbB_hash"
    }
  ]
}
